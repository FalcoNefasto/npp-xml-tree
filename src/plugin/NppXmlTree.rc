#include <windows.h>

#include "resource.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,1,0,0
 PRODUCTVERSION 1,1,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x2L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "FalcoNefasto"
            VALUE "FileDescription", "XML Tree panel for Notepad++"
            VALUE "FileVersion", "1.1.0.0"
            VALUE "InternalName", "NppXmlTree"
            VALUE "LegalCopyright", "FalcoNefasto"
            VALUE "OriginalFilename", "NppXmlTree.dll"
            VALUE "ProductName", "XML Tree"
            VALUE "ProductVersion", "1.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

IDD_PROBLEMS DIALOGEX 0, 0, 340, 170
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_MAXIMIZEBOX
CAPTION "XML Tree: check well-formedness"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LISTBOX         IDC_PROBLEM_LIST, 7, 7, 245, 156, LBS_NOINTEGRALHEIGHT | LBS_HASSTRINGS | WS_VSCROLL | WS_HSCROLL | WS_TABSTOP
    PUSHBUTTON      "Previous", IDC_PROBLEM_PREVIOUS, 258, 7, 75, 14
    PUSHBUTTON      "Next", IDC_PROBLEM_NEXT, 258, 25, 75, 14
    PUSHBUTTON      "Close", IDC_PROBLEM_CLOSE, 258, 43, 75, 14
END

IDD_ABOUT DIALOGEX 0, 0, 216, 108
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About XML Tree"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "XML Tree", IDC_ABOUT_TITLE, 12, 10, 192, 16
    LTEXT           "Version 1.0", IDC_ABOUT_VERSION, 12, 30, 192, 10
    LTEXT           "FalcoNefasto", IDC_ABOUT_AUTHOR, 12, 44, 192, 10, SS_NOTIFY
    LTEXT           "A tree panel for XML in Notepad++", IDC_ABOUT_DESCRIPTION, 12, 62, 192, 10
    DEFPUSHBUTTON   "OK", IDOK, 158, 86, 46, 14
END
